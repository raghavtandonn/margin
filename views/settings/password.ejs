<%- include('_open') %>
  <form method="post" action="/settings/password" class="auth-form measure">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field">
      <span class="field-label mono-s">NEW PASSWORD</span>
      <input name="password" type="password" autocomplete="new-password" required
             minlength="8" maxlength="256" autofocus>
      <span class="note">Eight characters or more.</span>
    </label>
    <button class="auth-action" type="submit">CHANGE IT →</button>
    <p class="note mt-14">Every other signed-in device will be signed out.</p>
  </form>
<%- include('_close') %>
