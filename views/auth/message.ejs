<%- include('_open') %>
  <div class="mono-s auth-label"><%= title.toUpperCase() %></div>
  <h1 class="auth-title"><%= heading %></h1>
  <% if (locals.detail) { %><p class="auth-lede"><%= detail %></p><% } %>

  <% if (locals.action) { %>
    <% if (action.post) { %>
      <form method="post" action="<%= action.href %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="auth-action" type="submit"><%= action.label %> →</button>
      </form>
    <% } else { %>
      <a class="auth-action" href="<%= action.href %>"><%= action.label %> →</a>
    <% } %>
  <% } %>
<%- include('_close') %>
