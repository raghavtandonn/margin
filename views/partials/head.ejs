<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · MARGIN</title>
<meta name="description" content="A reading log.">
<%# Fonts are served from this origin. Google Fonts would require
    style-src https://fonts.googleapis.com and font-src https://fonts.gstatic.com,
    and would hand a third party the IP address of every reader on every page
    load — which is not a trade this product's own privacy spec permits. %>
<link rel="stylesheet" href="/css/fonts.css?v=<%= v.fonts %>">
<link rel="stylesheet" href="/css/margin.css?v=<%= v.css %>">
<link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" fill="%23191714"/><text x="16" y="23" font-family="Georgia,serif" font-size="15" text-anchor="middle" fill="%23E8E4DC">M</text></svg>'>
<script nonce="<%= nonce %>">
  // Applied before first paint so the pattern-mode hatch and ragged-right
  // preference never flash their default state.
  try {
    var s = JSON.parse(localStorage.getItem('margin.settings') || '{}');
    if (s.pattern) document.documentElement.dataset.pendingPattern = '1';
    if (s.ragged) document.documentElement.dataset.pendingRagged = '1';
  } catch (e) {}
</script>
<meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
<meta name="margin-user" content="<%= locals.user?.public_id || '' %>">
<%# §10 — a public season carries OG tags pointing at its poster. Only a
    page that has explicitly passed one gets them: nothing else in this
    product is meant to be unfurled by a chat client. %>
<% if (locals.ogImage) { %>
<meta property="og:title" content="<%= title %>">
<meta property="og:type" content="article">
<meta property="og:image" content="<%= ogImage %>">
<meta property="og:image:width" content="1080">
<meta property="og:image:height" content="1920">
<% if (locals.ogDescription) { %><meta property="og:description" content="<%= ogDescription %>"><% } %>
<meta name="twitter:card" content="summary_large_image">
<% } %>
<%# §10 — "public but not indexable" is a legitimate state, and the default. %>
<% if (locals.robots) { %><meta name="robots" content="<%= robots %>"><% } %>
</head>
<body<%- locals.settings && settings.pattern_mode ? ' data-pattern="1"' : '' %><%- locals.settings && settings.ragged ? ' data-ragged="1"' : '' %>>
<%# The skip link reveals itself on :focus in CSS. Inline onfocus/onblur
    handlers are blocked by script-src just as firmly as an inline <script>. %>
<a href="#block" class="btn skip-link">SKIP TO CONTENT</a>
